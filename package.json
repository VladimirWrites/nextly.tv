{
  "name": "nextly",
  "version": "1.10.0",
  "description": "A private, zero-knowledge TV show tracker. Encrypted in your browser; no email, no password, no tracking.",
  "license": "Apache-2.0",
  "author": "Vladimir Jovanovic",
  "homepage": "https://nextly.tv",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "db:create": "npx wrangler d1 create nextly-db",
    "db:init": "npx wrangler d1 execute nextly-db --file=./schema.sql --remote",
    "db:create:preview": "npx wrangler d1 create nextly-db-preview",
    "db:init:preview": "npx wrangler d1 execute nextly-db-preview --file=./schema.sql --remote",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add public/sw.js public/js/version.js src/inline-hashes.js",
    "gen-icons": "python3 scripts/gen-icons.py",
    "gen-shots": "node scripts/gen-screenshots.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.115.0"
  }
}
